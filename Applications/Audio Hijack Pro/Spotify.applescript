-- script spotifylibset scriptsFolder to (path to library folder from user domain as string) & "Scripts:"set commonlib to load script alias (scriptsFolder & "Global.scpt")on nextSpotify()	--PMLog("Spotify", "nextSpotify") of commonlib	tell application "System Events"		tell process "Spotify"			key code 125 -- down arrow Key		end tell	end tellend nextSpotifyon prevSpotify()	--PMLog("Spotify", "prevSpotify") of commonlib	tell application "System Events"		tell process "Spotify"			key code 126 -- up arrow Key		end tell	end tellend prevSpotifyon playSpotify()	--PMLog("Spotify", "playSpotify") of commonlib	tell application "Spotify"		play		set theState to player state		if theState is not playing then			display alert "Spotify would not play, check the current track is playable and try again"			error -128		end if	end tell	return	tell application "System Events"		tell process "Spotify"			key code 36 -- return		end tell	end tellend playSpotifyon stopSpotify()	--PMLog("Spotify", "stopSpotify") of commonlib	tell application "Spotify"		set theState to player state		if theState is not paused then			pause		end if	end tell	return	tell application "System Events"		tell process "Spotify"			key code 49 -- space		end tell	end tellend stopSpotifyon playNextSpotify()	--PMLog("Spotify", "playNextSpotify") of commonlib	tell application "Spotify" to next track	return	tell application "System Events"		tell process "Spotify"			key code 124 using {command down} -- right arrow Key		end tell	end tellend playNextSpotifyon rewindSpotify()	say "Rewinding track"	tell application "Spotify"		pause		-- 			say "delay 2 seconds, Spotify should be stopped"		-- 			delay 2		tell current track			set thisTitle to name			set thisArtist to artist			set thisAlbum to album			set thisDuration to duration		end tell		-- 			say "getting current track which is " & thisTitle		previous track		tell current track			set prevTitle to name			set prevArtist to artist			set prevAlbum to album			set prevDuration to duration		end tell		-- 			say "getting previous track which is " & prevTitle		if thisTitle is equal to prevTitle and thisArtist is equal to prevArtist and thisAlbum is equal to prevAlbum and thisDuration is equal to prevDuration then			say "tracks identical, staying on this track"		else			say "tracks different, going to next track"			next track		end if		tell application "Spotify" to play	end tellend rewindSpotifyon skipDuplicate()	say "Checking for duplicates"	try		tell application "Spotify"			set noDuplicate to false			repeat while noDuplicate is false				if player state is paused then					tell application "Spotify" to playpause				end if				tell current track					delay 1					tell application "Spotify" to pause					set theTitle to name					set theArtist to artist					set theAlbum to album					set theDuration to duration					using terms from application "iTunes"						tell application "iTunes" to set foundTracks to search library playlist 1 for theTitle only songs						get count of foundTracks						if the result is 0 then							set noDuplicate to true						else							set foundOne to false							repeat with aTrack in foundTracks								if artist of aTrack is theArtist then									if album of aTrack is theAlbum then										say "Skipping duplicate" & theTitle										tell application "Spotify" to next track										delay 5										set noDuplicate to false										set foundOne to true									end if								end if							end repeat							if foundOne is false then								say "No duplicates found"								set noDuplicate to true							end if						end if					end using terms from				end tell			end repeat		end tell	on error errMsg number errNum		say "Error checking duplicates" & errMsg	end tryend skipDuplicateon nextTrack()	try		tell application "Spotify"			playSpotify() of me			skipDuplicate() of me			stopSpotify() of me			try				tell current track					get id				end tell			on error errMsg number errNum				display dialog "Start Spotify: Doesn't seem to be a current track, select a playlist and a track to start" & errMsg				return			end try			say "get current track data"			tell current track				set theTitle to name				set theArtist to artist				set theAlbum to album				set theDuration to duration			end tell			playSpotify() of spotifylib			delay 5			rewindSpotify() of spotifylib			try				tell application "Audio Hijack Pro"					-- setup Hijack tags					set theSession to first session whose name is "Spotify" --By name 					set title tag of theSession to theTitle					set album tag of theSession to theAlbum					set artist tag of theSession to theArtist					say "Setting silence monitor to stop"					set silence monitor action of theSession to {action:stop, duration:1.5, level:-60.0}					start recording theSession				end tell							on error errMsg number errNum				display dialog "Start Spotify: Could not start recording session, stopping script. " & errMsg				return			end try		end tell	on error errMsg number errNum		display dialog "Spotify: Can't connect to Spotify, stopping script. " & errMsg	end tryend nextTrack-- end script