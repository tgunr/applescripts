property scriptsFolder : (path to library folder from user domain as string) & "Scripts:"property commonlib : load script alias (scriptsFolder & "Global.scpt")property spotifylib : load script alias (scriptsFolder & "Applications:Audio Hijack Pro:Spotify.scpt")on process(theArgs)	--Coerce args to thus be a list	if class of theArgs is not list then		set theArgs to {theArgs}	end if	--Into iTunes ye files shall go		-- 	say "Disabling silence monitor"	tell application "Audio Hijack Pro"		set theSession to first session whose name is "Spotify"		set silence monitor action of theSession to {action:do nothing}	end tell	using terms from application "iTunes"		repeat with theFile in theArgs			set savedTextItemDelimiters to AppleScript's text item delimiters			set AppleScript's text item delimiters to {"•"}			set aFile to theFile as string			set aPath to first text item of aFile			set aPath to trimWhiteSpace(aPath) of commonlib			set aAlbum to second text item of aFile			set aAlbum to trimWhiteSpace(aAlbum) of commonlib			set aTitleFile to last text item of aFile			set aTitleFile to trimWhiteSpace(aTitleFile) of commonlib			set AppleScript's text item delimiters to {":"}			set aArtist to last text item of aPath			set aArtist to trimWhiteSpace(aArtist) of commonlib			set AppleScript's text item delimiters to {"."}			set aTitle to first text item of aTitleFile			set aTitle to trimWhiteSpace(aTitle) of commonlib			set AppleScript's text item delimiters to savedTextItemDelimiters			set logmsg to "artist: " & aArtist & " album: " & aAlbum & " title: " & aTitle			PMLog("AddToiTunes", "processed " & logmsg) of commonlib			try				tell application "iTunes"					PMLog("AddToiTunes", "adding to iTunes file: " & aFile) of commonlib										-- look for previous tracks of same name with duration < 10 seconds					try						set foundTracks to search library playlist 1 for aTitle only songs						repeat with aTrack in foundTracks							if duration of aTrack is less than 10 then								set theFile to location of aTrack								delete aTrack								try									tell application "Finder" to delete theFile								on error									PMLog("AddToiTunes", "The Finder could not delete the file: " & theFile) of commonlib								end try							end if						end repeat					on error						PMLog("AddToiTunes", "iTunes could not delete the track: " & aTrack & " that had a less than 10 second duration.") of commonlib					end try										set aTrack to (add theFile)					delay 2					try						tell aTrack							set name to aTitle							set album to aAlbum							set artist to aArtist						end tell						tell application "Finder" to delete theFile					on error errMsg number errNum						PMLog("AddToiTunes", "iTunes could not set values: " & errMsg) of commonlib					end try				end tell			on error errMsg number errNum				PMLog("AddToiTunes", "iTunes error: " & errMsg) of commonlib			end try		end repeat	end using terms from	nextTrack() of spotifylibend process--process("/Users/davec/Music/Audio Hijack/Fools & Horses• Fools & Horses• Follow.m4a") of me