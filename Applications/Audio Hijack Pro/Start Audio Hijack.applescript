property track : {title:"value1", artist:"value2", album:"value3"}property prevID : 0property startScript : "/Users/davec/Dropbox/Private/Library/Scripts/Applications/Audio Hijack Pro/Start Spotify.scpt"property addScript : "/Users/davec/Dropbox/Private/Library/Scripts/Applications/Audio Hijack Pro/Add To iTunes Library Delimited.scpt"set commonScript to load script alias ((path to library folder from user domain as string) & "Scripts:Global.scpt")try	tell application "Spotify" to activateon error	display dialog "Start Audio Hijack: Spotify did not activate, stopping script"	returnend trytell application "System Events"	tell process "Spotify"		set spotifyAppPath to application file	end tellend telltry	tell application "Audio Hijack Pro"		activate		set theSession to first session whose name is "Spotify" --By name		-- 		tell theSession		-- 			stop recording		-- 			set targeted application to spotifyAppPath		-- 			set name to "Spotify"		-- 			set output name format to "%tag_artist• %tag_album• %tag_title"		-- 			set post recording script to addScript		-- 			set recording format to {bit rate:192, channels:Stereo, encoding:AAC, quality:10, style:Normal, VBR quality:0}		-- 			set silence monitor action to {action:stop, duration:1.0, level:-60.0}		-- 		end tell		tell application "System Events"			tell process "Audio Hijack Pro"				try					try						-- switch to Input tab						click button 4 of splitter group 1 of window "Audio Hijack Pro"						delay 1					on error errMsg number errNum						display dialog "Start Audio Hijack: Could not complete process for Audio Hijack Pro, stopping script"						return					end try					-- uncheck open URL					try						set scriptChecked to value of checkbox "Open URL/File/AppleScript" of group 1 of group 1 of splitter group 1 of window "Audio Hijack Pro"						if scriptChecked is 1 then							click checkbox "Open URL/File/AppleScript" of group 1 of group 1 of splitter group 1 of window "Audio Hijack Pro"						end if					on error errMsg number errNum						display dialog "Start Audio Hijack: Could not complete process for Audio Hijack Pro, stopping script"						return					end try										-- Turn Off Hijack (if need) and then turn it on					try						-- if it is on, turn it off						set hijackBtn to value of checkbox "Hijack" of group 1 of tool bar 1 of window "Audio Hijack Pro"						if hijackBtn is 1 then							click checkbox "Hijack" of group 1 of tool bar 1 of window "Audio Hijack Pro"						end if						-- now turn it on						click checkbox "Hijack" of group 1 of tool bar 1 of window "Audio Hijack Pro"						delay 1						try							-- see if we have to quit and relaunch							if accessibility description of window 1 is "alert" then								click button "Quit And Relaunch" of window 1							end if						end try					on error errMsg number errNum						display dialog "Start Audio Hijack: Could not complete process for Audio Hijack Pro, stopping script"						return					end try					try						with timeout of 10 seconds							repeat until accessibility description of window 1 is not "alert"							end repeat						end timeout					on error errMsg number errNum						if errNum is -1712 then							display dialog "Start Audio Hijack: timed out waiting for Spotify to quit and relaunch"						end if					end try					-- turn off Hijack					click checkbox "Hijack" of group 1 of tool bar 1 of window "Audio Hijack Pro"					-- turn on URL checkbox					click checkbox "Open URL/File/AppleScript" of group 1 of group 1 of splitter group 1 of window "Audio Hijack Pro"					set value of text field 1 of group 1 of group 1 of splitter group 1 of window "Audio Hijack Pro" to startScript				on error errMsg number errNum					display dialog "Start Audio Hijack: Could not complete process for Audio Hijack Pro, stopping script"					return				end try			end tell		end tell		-- 		set theSession to first session whose name is "Spotify" --By name		-- 		if hijacked of theSession is false then		-- 			start hijacking theSession		-- 		end if	end tellon error errMsg number errNum	display dialog "Start Audio Hijack: Could not connect to Audio Hijack Pro, stopping script"	returnend try-- tell application "Audio Hijack Pro"-- 	activate-- end tell-- -- display dialog "Setup your playlist in Spotify and select the first track. When ready, click OK"tell application "Spotify"	activate	set sound volume to 100end tell