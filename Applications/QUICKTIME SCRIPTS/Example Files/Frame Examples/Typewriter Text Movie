tell application "QuickTime Player"	launch	activate	stop every movie	display dialog "Creating typewriter movieÉ" buttons {"¥"} default button 1 giving up after 2	make new movie	display dialog "Adding frames. One momentÉ" buttons {"¥"} default button 1 giving up after 2	set the default_timescale to the time scale of movie 1	set the default_duration to ((default_timescale / 6) div 1)	set this_track to make new track at movie 1 with data " "	tell track 1		set dimensions to {160, 48}		my set_textframe(1, false, " ", default_duration, false, false, "white", "black", "Courier", 24, center)	end tell	tell movie 1		set the display_text to ("QUICKTIME" & return & "ROCKS!")		set the string_length to the length of the display_text		-- add a blank frame at the start		my set_textframe(1, true, " ", default_duration, false, false, "white", "black", "Courier", 24, center)		repeat with i from 1 to the string_length			set this_text to (characters 1 thru i of the display_text) as string			my set_textframe(1, true, this_text, default_duration, false, false, "white", "black", "Courier", 24, center)		end repeat		-- add extra end frames		repeat 4 times			my set_textframe(1, true, display_text, default_duration, false, false, "white", "black", "Courier", 24, center)		end repeat		set the full text of annotation "Full Name" to "Typewriter Movie"		set looping to true		display dialog "Process completed." buttons {"¥"} default button 1 giving up after 2		play	end tellend tellon set_textframe(track_nameindex, make_status, this_text, this_duration, keyed_value, antialias_value, Â	background_color, text_color, default_typeface, default_typesize, justification_value)	if background_color is "white" then		set the background_color to {65535, 65535, 65535}	else if background_color is "black" then		set the background_color to {0, 0, 0}	end if	if text_color is "white" then		set the text_color to {65535, 65535, 65535}	else if text_color is "black" then		set the text_color to {0, 0, 0}	end if	tell application "QuickTime Player"		tell movie 1			set the time_scale to the time scale			if make_status is true then				set this_frame to make new frame at track track_nameindex with data (this_text)			end if			tell the last frame of track track_nameindex				set the duration to this_duration				set keyed to keyed_value				set antialias to antialias_value				set the background color to background_color				set the foreground color to text_color				set the default font to default_typeface				set the default font size to default_typesize				set the justification to justification_value				if make_status is false then set the contents to this_text			end tell		end tell	end tellend set_textframe