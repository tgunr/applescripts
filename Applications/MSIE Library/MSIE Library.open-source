property parent : application "Internet Explorer"property AboutInfo : "MSIE Library - Julifos Fine Arts - 2001" & return & "Some question? Mail me to julifos@excite.com"property version : 1.3on modifyimage(imgID, attribute, newvalue)	if class of attribute = list then		set nat to ""		repeat with i from 1 to count attribute			set nv to newvalue's item i			if class of nv = string then set nv to "\"" & nv & "\""			set nat to nat & (attribute's item i) & "=" & nv & ","		end repeat		set attrivalue to (characters 1 thru -2 of nat as text)	else		if class of newvalue = string then set newvalue to "\"" & newvalue & "\""		set attrivalue to attribute & "=" & newvalue	end if	if imgID = "all" then		do script "for (var i=0; i<document.images.length;i++) {with (document.images[i]) {" & attrivalue & "}}"	else		if class of imgID = list then			set AppleScript's text item delimiters to ","			set imgID to imgID as text			set AppleScript's text item delimiters to ""		else			set imgID to "\"" & imgID & "\""		end if		do script "a = new Array(" & imgID & ");for (var i=0; i<a.length;i++) {w = a[i];with (document.images[w]) {" & attrivalue & "}}"	end ifend modifyimageon sendcookie(nombre, valor, caduca)	if class of caduca ­ string and caduca ­ {} then		set caduca to (caduca's item 1) & "," & ((caduca's item 2) - 1) & "," & (caduca's item 3)	else		set caduca to "\"" & caduca & "\""	end if	do script "CADUCA = new Date (" & caduca & ");document.cookie = \"" & nombre & "=" & valor & ";expires=\" + CADUCA.toGMTString();"end sendcookieon currentcookies()	set y to (do script "document.cookie")	set AppleScript's text item delimiters to "; "	set y to every text item of y	set z to {}	try		repeat with i in y			set AppleScript's text item delimiters to "="			set {a, b} to every text item of i			set z to z & {{cookiename:a} & {cookievalue:b}}		end repeat	on error	end try	set AppleScript's text item delimiters to ""	zend currentcookieson writedata(t)	do script "document.open();document.write(\"" & t & "\");document.close();"end writedataon openwindow given data:{x, y, z, a}	try		set theCode to "myWin = window.open(\"" & x & "\",\"" & y & "\",'" & z & "');"		if a ­ "" then set theCode to theCode & "myWin.document.open();myWin.document.write('" & a & "');myWin.document.close();"	on error		set theCode to "window.open()"	end try	do script theCodeend openwindowon setcolor(theelement, thecolor)	do script "document." & theelement & "Color = \"" & thecolor & "\""end setcoloron getcolor(theelement)	do script "document." & theelement & "Color"end getcolorscript Formularios	global FormID	global FormElement	global ElementValue	on setvalue()		if class of FormElement = list then			if class of FormID = string then set FormID to "\"" & FormID & "\""			repeat with i from 1 to count items of FormElement				set ei to item i of FormElement				if class of ei = string then set ei to "\"" & ei & "\""				set ev to item i of ElementValue				if class of ev = string then set ev to "\"" & ev & "\""				set valor to (my wathvalue(FormID, ei))				do script "document.forms[" & FormID & "].elements[" & ei & "]." & valor & ev			end repeat		else			if class of FormID = string then set FormID to "\"" & FormID & "\""			if class of FormElement = string then set FormElement to "\"" & FormElement & "\""			if class of ElementValue = string then set ElementValue to "\"" & ElementValue & "\""			set valor to (my wathvalue(FormID, FormElement))			do script "document.forms[" & FormID & "].elements[" & FormElement & "]." & valor & ElementValue		end if	end setvalue	on activate trueorfalse		if class of FormID = string then set FormID to "\"" & FormID & "\""		if class of FormElement = string then set FormElement to "\"" & FormElement & "\""		if trueorfalse then			set thecommand to "focus()"		else			set thecommand to "blur()"		end if		try			do script "document.forms[" & FormID & "].elements[" & FormElement & "]." & thecommand		on error			return 0		end try	end activate	on select		if class of FormID = string then set FormID to "\"" & FormID & "\""		if class of FormElement = string then set FormElement to "\"" & FormElement & "\""		try			do script "document.forms[" & FormID & "].elements[" & FormElement & "].select()"		on error			return 0		end try	end select	on submit()		if class of FormID = string then set FormID to "\"" & FormID & "\""		do script "document.forms[" & FormID & "].submit()"	end submit	on reset()		if class of FormID = string then set FormID to "\"" & FormID & "\""		do script "document.forms[" & FormID & "].reset()"	end reset	on listforms()		set theCode to Â			"n= new Array();for (var i=0; i<document.forms.length;i++) {m= new Array();f=document.forms[i];for (var z=0;z<document.forms[i].elements.length;z++){p = new Array();e = document.forms[i].elements[z];for (var x=0;x<document.forms[i].elements[z].length;x++){o = document.forms[i].elements[z].options[x];p= p  +  \"^^\" +o.text + \"¥\" + o.value + \"¥\" + o.selected + \"\\r\";}m= m + \"``\" +  e.name + \"¥\" + e.type + \"¥\" + e.value + \"¥\" + e.checked + \"\\r\"  + p;}n = n + \"¬¬\" + f.name + \"¥\" + f.action + \"¥\" + f.method + \"¥\" + f.encoding + \"\\r\" +  m;}"		set k to (do script theCode)		set theforms to rest of (my StringToList(k, "¬¬"))		set Forms to {}		repeat with theform in theforms			set {fID, faction, fmethod, fEncoding} to (my StringToList(theform's paragraph 1, "¥"))			set theElements to rest of (every paragraph of theform)			set theElements to rest of (my StringToList(theElements as text, "``"))			set theelementx to {}			repeat with theelement in theElements				set mEL to (my StringToList(theelement, "^^"))				if (count mEL) ­ 1 then					set {eID, eType, eValue, eChecked} to (my StringToList(mEL's item 1, "¥"))					try						set eValue to eValue as boolean					on error					end try					set reC to {eID:eID} & {eType:eType} & {eValue:eValue}					try						set eChecked to eChecked as boolean						set reC to reC & {eChecked:eChecked}					on error					end try					set theoptions to rest of mEL					set eOptions to {}					repeat with theoption in theoptions						set {oText, oValue, oSelected} to (my StringToList(theoption, "¥"))						try							set oValue to oValue as boolean						on error						end try						set eOptions to eOptions & {{oText:oText} & {oValue:oValue} & {oSelected:oSelected as boolean}}					end repeat					set theelementx to theelementx & {reC & {eOptions:eOptions}}				else					set {eID, eType, eValue, eChecked} to (my StringToList(mEL as text, "¥"))					set reC to {eID:eID} & {eType:eType} & {eValue:eValue}					try						set eChecked to eChecked as boolean						set reC to reC & {eChecked:eChecked}					on error					end try					set theelementx to theelementx & {reC}				end if			end repeat			set FormX to {{fID:fID} & {faction:faction} & {fmethod:fmethod} & {fEncoding:fEncoding} & {fElements:theelementx}}			set Forms to Forms & FormX		end repeat		Forms	end listforms	-- Subroutines	on wathvalue(fID, eID)		set valor to do script "document.forms[" & fID & "].elements[" & eID & "].checked"		if valor = "undefined" then			return "value ="		else			return "checked ="		end if	end wathvalue	on StringToList(k, tid)		set AppleScript's text item delimiters to tid		set k to every text item of k		set AppleScript's text item delimiters to ""		k	end StringToListend scriptto statistics with allinfo	try		set allinfo to allinfo		set {theUrl, theName, lMod} to my StringToList((do script "theurl = window.location;thename = document.title;lMod = document.lastModified;theurl + \"¥\" + thename + \"¥\" + lMod"))		set AppleScript's text item delimiters to "/"		set relUrl to every text item of theUrl		set relUrl to rest of (reverse of relUrl)		set relUrl to (reverse of relUrl as text) & "/"		set AppleScript's text item delimiters to ""		set thesource to (Çevent MSIESORCÈ) -- GetSource		set thelength to length of thesource		set theCode to "n= new Array();for (var i=0; i<document.forms.length;i++) {x = document.forms[i];n = n + x.name + \"¥\" + x.action + \"¥\" + x.method + \"\\r\"}"		set FormsInfo to {}		try			set yx to items 1 thru -2 of (every paragraph of (do script theCode))			repeat with ix in yx				set {fname, theaction, fmethod} to my StringToList(ix)				set theaction to my AbsolURL(theUrl, theaction)				set FormInfo to {{formname:fname} & {formaction:theaction} & {formmethod:fmethod}}				set FormsInfo to FormsInfo & FormInfo			end repeat		on error -- no forms		end try		set {pagecharset, comesfrom} to (my StringToList(do script "document.charset + \"¥\" + document.referrer"))				-- pillar im‡genes		if allinfo then			set allimgs to {}			-- background images			set {bgimgs, uppcase} to {my returnprashes(">", "background=", thesource), false}			if bgimgs = {} then set {bgimgs, uppcase} to {my returnprashes(">", "BACKGROUND=", thesource), true}			if bgimgs ­ {} then				if uppcase then					repeat with bgimg in bgimgs						set bgimg to (my SearchReplace("BACKGROUND=", "", (my returnprashes(" ", "BACKGROUND=", bgimg) as text)))						set bgimg to (my SearchReplace("\"", "", bgimg))						set allimgs to allimgs & bgimg					end repeat				else					repeat with bgimg in bgimgs						set bgimg to (my SearchReplace("background=", "", (my returnprashes(" ", "background=", bgimg) as text)))						set bgimg to (my SearchReplace("\"", "", bgimg))						set allimgs to allimgs & bgimg					end repeat				end if			end if			set newimgs to {}			repeat with i from 1 to count allimgs				set timg to allimgs's item i				set newimgs to newimgs & (my AbsolURL(relUrl, timg))			end repeat			set allimgs to newimgs & (my ExtractObjects("images", "src"))			set allobjects to my ExtractObjects("embeds", "src")			set alllinks to my ExtractObjects("links", "href")			set pInfo to {PageTitle:theName} & {PageURL:theUrl} & {BaseUrl:relUrl} & {LastModified:lMod} & {Charset:pagecharset} & {ComeFrom:comesfrom} & {CodeLength:thelength} & {Forms:FormsInfo} & {ImageURLs:allimgs} & {EmbededObjects:allobjects} & {Links:alllinks}		else			set pInfo to {PageTitle:theName} & {PageURL:theUrl} & {BaseUrl:relUrl} & {LastModified:lMod} & {Charset:pagecharset} & {ComeFrom:comesfrom} & {CodeLength:thelength} & {Forms:FormsInfo}		end if		return pInfo	on error		return 0	end tryend statisticson ExtractObjects(obj, v)	set y to (do script "n= new Array();for (var i=0; i<document." & obj & ".length;i++) {n = n + (document." & obj & "[i]." & v & ") + \"\\r\"}")	try		set alllinks to items 1 thru -2 of (every paragraph of y)	on error		return {}	end tryend ExtractObjectson displayconfirm(msg)	(do script "confirm(\"" & msg & "\")") as booleanend displayconfirmon displayprompt(msg, ans)	do script "prompt(\"" & msg & "\", \"" & ans & "\")"end displayprompton loadpage(wheretogo)	try		do script "window.history.go(" & wheretogo & ")"	on error		return 0	end tryend loadpageon location(frame, theloc)	try		if frame ­ 0 then			if (do script "frames[\"" & frame & "\"]") = "undefined" then return 0			set theresult to (do script "frames[\"" & frame & "\"].location=\"" & theloc & "\"")		else			do script "window.location=\"" & theloc & "\""		end if	on error		return 0	end tryend locationto resizewin to {w, h, centered}	try		set theCode to "resizeTo((\"" & w & "\"),(\"" & h & "\"))"		if centered then			if (w = 0) and (h = 0) then				set x to 0				set y to 0				set theCode to (do script "\"resizeTo((\\\"\" + screen.availWidth + \"\\\"),(\\\"\" + screen.availHeight + \"\\\"))\"")			else				set {x, y} to every paragraph of (do script "Math.round((screen.availWidth)/2 - (" & w & "/2)) + \"\\r\" + Math.round((screen.availHeight)/2 - (" & h & "/2))")				set {x, y} to {x as integer, y as integer}			end if			set theCode to theCode & return & "moveTo(" & x & "," & y & ")"		end if		repeat 2 times			do script theCode		end repeat	on error		return 0	end tryend resizewinto movewin to {x, y}	try		do script "moveTo(" & x & "," & y & ")"	on error		return 0	end tryend movewinto scrollwin to {x, y}	try		do script "window.scroll(" & x & "," & y & ")"	on error		return 0	end tryend scrollwinto refreshplugins with reload	do script "navigator.plugins.refresh(" & reload & ")"end refreshpluginson aboutmonitor()	try		set {availablew, availableh, realw, realh, Colores} to every paragraph of (do script "screen.availWidth + \"\\r\" + screen.availHeight +  \"\\r\" + screen.width + \"\\r\" + screen.height + \"\\r\" + Math.pow(2,screen.colorDepth)")		set k2 to {Resolution:{realw as number, realh as number}} & {AvailableSize:{availablew as number, availableh as number}} & {Colores:Colores as real}	on error		return 0	end tryend aboutmonitoron aboutnavigator()	set {appname, appcode, appversion, useragent} to every paragraph of (do script "navigator.appName + \"\\r\" + navigator.appCodeName + \"\\r\" + navigator.appVersion + \"\\r\" + navigator.userAgent")	return {appname:appname} & {appcode:appcode} & {appversion:appversion} & {useragent:useragent}end aboutnavigatoron aboutplugins()	set k to items 1 thru -2 of (every paragraph of (do script "n= new Array();for (var i=0; i<navigator.plugins.length;i++) {x = navigator.plugins[i];n = n + x.name + \"¥\" + x.filename + \"¥\" + x.description + \"¥\" + x[0].type + \"¥\" + x[0].suffixes + \"\\r\"}"))	set pluginfo to {}	repeat with i in k		set {plname, pfname, desc, mtype, PSuffixes} to (my StringToList(i))		set pluginfo to pluginfo & {{PName:plname} & {PFilename:pfname} & {PDescription:desc} & {PMimeType:mtype} & {PSuffixes:PSuffixes}}	end repeat	pluginfoend aboutpluginson aboutmimetype(num)	if num = "all" then		set k to items 1 thru -2 of (every paragraph of (do script "n=\"\";for (var i=0; i<navigator.mimeTypes.length;i++) {x = navigator.mimeTypes[i];n = n + x.suffixes + \"¥\" + x.type  + \"¥\" +  x.description + \"\\r\"};"))		set mimeTypes to {}		repeat with i in k			set {MTSuffixes, MTType, MTDescription} to (my StringToList(i))			set mimeTypes to mimeTypes & {{MTSuffixes:MTSuffixes} & {MTType:MTType} & {MTDescription:MTDescription}}		end repeat	else		if class of num = list then			set AppleScript's text item delimiters to ","			set num to num as text			set AppleScript's text item delimiters to ""		else			set num to "\"" & num & "\""		end if		set k to items 1 thru -2 of (every paragraph of (do script "a = new Array(" & num & ");n=\"\";for (var i=0; i<a.length;i++) {w = a[i];x = navigator.mimeTypes[w];if (x.enabledPlugin != null) {z=true+\"¥\" +x.enabledPlugin.name}; else {z=false+\"¥\" + \"\"};n = n + x.suffixes + \"¥\" + x.type  + \"¥\" +  x.description + \"¥\" +  z + \"\\r\"};"))		set mimeTypes to {}		repeat with i in k			set {MTSuffixes, MTType, MTDescription, PluginEnabled, PluginName} to (my StringToList(i))			set reC to {MTSuffixes:MTSuffixes} & {MTType:MTType} & {MTDescription:MTDescription} & {PluginEnabled:PluginEnabled as boolean} & {PluginName:PluginName}			set mimeTypes to mimeTypes & {reC}		end repeat	end if	return mimeTypesend aboutmimetypeon aboutimage(imgID)	if imgID = "all" then		set k to items 1 thru -2 of (every paragraph of (do script "n=\"\";for (var i=0; i<document.images.length;i++) {with (document.images[i]) {a=name,b=src,c=width,d=height,e=complete,f=border,g=lowsrc,h=vspace,j=hspace};n = n + a + \"¥\" +b+\"¥\" +c+\"¥\" +d+\"¥\" +e+\"¥\" +f+\"¥\" +g+\"¥\" +h+\"¥\" +j + \"\\r\"};"))		set allimgs to {}		repeat with i in k			set {n, src, w, h, loaded, border, lowsrc, vspace, hspace} to (my StringToList(i))			set allimgs to allimgs & {{name:n} & {src:src} & {width:w as integer} & {height:h as integer} & {complete:loaded as boolean} & {border:border as integer} & {lowsrc:lowsrc} & {vspace:vspace as integer} & {hspace:hspace as integer}}		end repeat	else		if class of imgID = list then			set AppleScript's text item delimiters to ","			set imgID to imgID as text			set AppleScript's text item delimiters to ""		else			set imgID to "\"" & imgID & "\""		end if		set k to items 1 thru -2 of (every paragraph of (do script "a = new Array(" & imgID & ");n=\"\";for (var i=0; i<a.length;i++) {w = a[i];with (document.images[w]) {aa=name,b=src,c=width,d=height,e=complete,f=border,g=lowsrc,h=vspace,j=hspace};n = n + aa + \"¥\" +b+\"¥\" +c+\"¥\" +d+\"¥\" +e+\"¥\" +f+\"¥\" +g+\"¥\" +h+\"¥\" +j + \"\\r\"};"))		set allimgs to {}		repeat with i in k			set {n, src, w, h, loaded, border, lowsrc, vspace, hspace} to (my StringToList(i))			set allimgs to allimgs & {{name:n} & {src:src} & {width:w as integer} & {height:h as integer} & {complete:loaded as boolean} & {border:border as integer} & {lowsrc:lowsrc} & {vspace:vspace as integer} & {hspace:hspace as integer}}		end repeat	end if	return allimgsend aboutimageon aboutme()	return AboutInfoend aboutmeon bookmark()	try		set theFavorites to (path to preferences as string) & "Explorer:Favorites.html"		set {theUrl, theName} to my StringToList((do script "window.location + \"¥\" + document.title"))		set theBookmark to return & return & "<DT><A HREF=\"" & theUrl & "\">" & theName & "</A>" & Â			return & return & "</DL><p>" & return & return		try			set FileOpen to open for access file theFavorites with write permission			set k to (get eof of FileOpen)			set w to (read FileOpen from (k - 20) to k)			set q to (offset of "</DL>" in w) - 1			set StartWrite to k - q			write theBookmark to FileOpen starting at StartWrite			close access FileOpen		on error			close access FileOpen		end try		Çevent MOSSbookÈ (theFavorites as alias) -- Open bookmark	on error msg		return msg	end tryend bookmark-- self-contained handlerson returnprashes(tid, off, txt)	set listreturned to {}	set AppleScript's text item delimiters to tid	set txt to txt's every text item	repeat with i from 1 to count txt		set itemI to item i of txt		if off is in contents of itemI then			try				set founded to (offset of off in itemI)				set founded to (text from character founded to last character of itemI)				set listreturned to listreturned & founded			on error			end try		end if	end repeat	set AppleScript's text item delimiters to {""}	return listreturnedend returnprasheson SearchReplace(s, r, theText)	tell (a reference to AppleScript's text item delimiters)		set {oldTID, contents} to {contents, {s}}		try			set {lT, contents} to {(text items of theText), {r}}			set {nT, contents} to {(lT as text), oldTID}			return nT		on error msg number n			set contents to oldTID			error msg number n		end try	end tellend SearchReplaceon AbsolURL(bu, u)	if ":" is in contents of u then		return u	else		try			if first item of u ­ "/" then				set AppleScript's text item delimiters to "../"				set k to every text item of u				set w to (count k)				if w = 1 then					set del to "/"				else					set {del, k} to {"", {k's item -2, k's item -1}}				end if			else				set {k, w, del} to {u, -3, ""}			end if			set AppleScript's text item delimiters to "/"			set k2 to ((text items from text item 1 of bu to (-1 - w) of bu) as text) & del & (k as text)			set AppleScript's text item delimiters to ""			return k2		on error			return u		end try	end ifend AbsolURLon StringToList(k)	set AppleScript's text item delimiters to "¥"	set k to every text item of k	set AppleScript's text item delimiters to ""	kend StringToList-- Žste es gratis...on OffsetOf(theitem, thelist)	set i to 0	repeat with ListItem in the thelist		set i to i + 1		if (theitem = contents of ListItem) then exit repeat	end repeat	iend OffsetOf