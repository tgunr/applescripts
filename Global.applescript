-- script commonlibon PMLog(id, themessage)	set theLine to "logger -t " & id & " " & quoted form of themessage	do shell script theLineend PMLogon applicationWithBundleID(aName, aBundleID)	try		return (application id aBundleID) --10.5	on error		try			tell application "Finder" to set appFile to application file id aBundleID			return application (name of appFile) --10.4 w/ bid		on error			return application aName ----Failsafe		end try	end tryend applicationWithBundleIDon processWithBundleID(aName, aBundleID)	tell application "System Events"		try			set pID to (application processes where bundle identifier is aBundleID)		on error			set pID to (application processes where name is aName)		end try		return item 1 of pID	end tellend processWithBundleIDon trimWhiteSpace(aString)	if aString is not "" then		-- setup for no delimiter		set savedTextItemDelimiters to AppleScript's text item delimiters		set AppleScript's text item delimiters to ""		-- start with the tail end by revering the list		set these_items to reverse of (every text item of aString)		-- keep peeling off 1st space		repeat while item 1 of these_items is space			set these_items to rest of these_items		end repeat		-- flip the list, now do the leading characters		set these_items to reverse of these_items		repeat while item 1 of these_items is space			set these_items to rest of these_items		end repeat		-- reconstruct the string		set these_items to these_items as string		-- restore and return		set AppleScript's text item delimiters to savedTextItemDelimiters		return these_items	end ifend trimWhiteSpace-- end script