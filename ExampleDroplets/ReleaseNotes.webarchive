        <p class="p10">php</p>
      </td>
      <td valign="top" class="td6">
        <p class="p10">'_PHP'</p>
      </td>
    </tr>
    <tr>
      <td valign="top" class="td4">
        <p class="p10">PythonOSA</p>
      </td>
      <td valign="top" class="td5">
        <p class="p10">python</p>
      </td>
      <td valign="top" class="td6">
        <p class="p10">'Py-c'</p>
      </td>
    </tr>
    <tr>
      <td valign="top" class="td4">
